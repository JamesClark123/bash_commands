  custom_args=()

  if [[ ${#other_args[@]} -eq 0 ]]; then

      commitType=$(gum choose "Amend" "Amend no edit" "Fixup" "Squash" --header "Select commit type" --limit 1)

      if [[ "$commitType" == "Amend" ]]; then
          custom_args+=(--amend)
      elif [[ "$commitType" == "Amend no edit" ]]; then
          custom_args+=(--amend --no-edit)
