      elif [[ "$commitType" == "Squash" ]]; then
          custom_args+=(--squash HEAD)
          custom_args+=(-m $(gum input --width 50 --placeholder "Enter commit message"))
      fi

  fi

  git commit "${custom_args[@]}" "${other_args[@]}"

